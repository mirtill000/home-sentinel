[Unit]
Description=Home Sentinel - LAN discovery + WiFi probe monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adatta subnet, interfacce e percorsi CSV al proprio ambiente.
ExecStart=/usr/bin/python3 /opt/home-sentinel/home_sentinel.py \
    --subnet 192.168.1.0/24 \
    --lan-csv /var/log/home-sentinel/lan_discovery.csv \
    --wifi-iface wlan1 \
    --wifi-csv /var/log/home-sentinel/wifi_probes.csv
WorkingDirectory=/opt/home-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
