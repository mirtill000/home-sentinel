[Unit]
Description=Home Sentinel - LAN discovery + WiFi probe monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adatta subnet, percorso del repo e percorsi dei log al proprio ambiente.
# Aggiungi "--wifi-iface wlan1 \" (interfaccia in monitor mode) e
# "--wifi-log /var/log/home-sentinel/wifi_probes.jsonl \" solo quando è
# disponibile un adattatore WiFi esterno dedicato: il WiFi onboard del
# Raspberry Pi 3 non supporta bene la monitor mode.
ExecStart=/usr/bin/python3 /opt/home-sentinel/home_sentinel.py \
    --subnet 192.168.1.0/24 \
    --lan-log /var/log/home-sentinel/lan_discovery.jsonl
WorkingDirectory=/opt/home-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
