[Unit]
Description=Home Sentinel - LAN discovery + WiFi/BLE probe monitor
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
# Adatta subnet e percorso del repo al proprio ambiente. I moduli di
# discovery scrivono di default in /var/log/home-sentinel/
# (lan_discovery.jsonl, wifi_probes.jsonl, ble_discovery.jsonl) —
# sovrascrivibile con --lan-log/--probe-log/--ble-log se serve un percorso
# diverso. Lo specchio SQLite (home-sentinel.db) e gli alert di detection
# (alerts_detection.jsonl) sono attivi di default, vedi --no-db/--db e
# --alerts-log nel README per personalizzarli.
#
# Aggiungi "--wifi-iface wlan1 \" solo quando è disponibile un adattatore
# WiFi esterno dedicato in monitor mode: il WiFi onboard del Raspberry Pi 3
# non lo supporta bene.
#
# Aggiungi "--ble \" per abilitare lo scan BLE: qui invece basta il
# Bluetooth onboard del Pi 3, nessun adattatore esterno necessario. Con
# --ble sono già attivi di default (nessun flag aggiuntivo richiesto) la
# classificazione euristica del tipo di device, il rilevamento tracker
# BLE (AirTag/Tile/SmartTag, vedi --ble-trusted-macs per escludere i
# propri) e i suggerimenti di collegamento identità per rotazione
# indirizzo (--no-ble-tracker-detection/--no-ble-identity-linking per
# disabilitarli); "--ble-watch-names Serratura \" per il rilevamento
# evil twin/spoofing BLE, "--ble-home-macs aa:bb:cc:...\" per il tracking
# presenza/assenza, "--ble-active \" per uno scan attivo invece che
# passivo (vedi README, sezione "Moduli di detection BLE").
#
# Moduli di detection opzionali (vedi README, sezione "Moduli di
# detection"): "--fingerprint \" per classificare il tipo di device,
# "--detect-rogue-dhcp \" per il rilevamento rogue DHCP,
# "--home-ssid CasaWiFi \" per il rilevamento evil twin WiFi (richiede
# --wifi-iface); "--capture-handshakes \" per la cattura passiva
# dell'handshake WPA/WPA2 delle reti in --home-ssid (audit offline della
# robustezza della propria password con aircrack-ng/hashcat, richiede
# --home-ssid già configurato — mai per reti diverse dalle proprie).
#
# Moduli di discovery avanzata opzionali, non detector di sicurezza (vedi
# README, sezione "Moduli di discovery avanzata"): "--dhcp-discovery \" per
# hostname via DHCP e rescan immediata su device nuovo, "--os-fingerprint \"
# per l'euristica passiva del sistema operativo, "--dhcp-lease-source
# /percorso/o/URL \" per il cross-check con le lease DHCP del router,
# "--deep-port-scan \" per un secondo port scan periodico su tutte le 65535
# porte TCP (una volta a settimana per device, non ad ogni ciclo) invece
# delle sole porte comuni scansionate normalmente.
ExecStart=/usr/bin/python3 /opt/home-sentinel/home_sentinel.py \
    --subnet 192.168.1.0/24
WorkingDirectory=/opt/home-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
