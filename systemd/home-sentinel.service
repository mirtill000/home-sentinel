[Unit]
Description=Home Sentinel - LAN discovery + WiFi probe monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adatta subnet, interfacce e percorsi dei log al proprio ambiente.
ExecStart=/usr/bin/python3 /opt/home-sentinel/home_sentinel.py \
    --subnet 192.168.1.0/24 \
    --lan-log /var/log/home-sentinel/lan_discovery.jsonl \
    --wifi-iface wlan1 \
    --wifi-log /var/log/home-sentinel/wifi_probes.jsonl
WorkingDirectory=/opt/home-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
