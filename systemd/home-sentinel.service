[Unit]
Description=Home Sentinel - LAN discovery + WiFi/BLE probe monitor
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
# Adatta subnet e percorso del repo al proprio ambiente. I tre moduli
# scrivono di default in /var/log/home-sentinel/ (lan_discovery.jsonl,
# wifi_probes.jsonl, ble_discovery.jsonl) — sovrascrivibile con
# --lan-log/--wifi-log/--ble-log se serve un percorso diverso.
#
# Aggiungi "--wifi-iface wlan1 \" solo quando è disponibile un adattatore
# WiFi esterno dedicato in monitor mode: il WiFi onboard del Raspberry Pi 3
# non lo supporta bene.
#
# Aggiungi "--ble \" per abilitare lo scan BLE: qui invece basta il
# Bluetooth onboard del Pi 3, nessun adattatore esterno necessario.
ExecStart=/usr/bin/python3 /opt/home-sentinel/home_sentinel.py \
    --subnet 192.168.1.0/24
WorkingDirectory=/opt/home-sentinel
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
